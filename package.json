{
  "name": "hirelab",
  "private": true,
  "version": "0.7.0",
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "tsx scripts/start-worker.ts",
    "storage:check": "tsx scripts/check-storage.ts",
    "requeue": "tsx scripts/requeue-processing.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check-migrations": "node scripts/check-migrations.cjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "verify": "npm run db:generate && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "mammoth": "^1.8.0",
    "next": "^14.2.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.0",
    "docx": "^9.7.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.20.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "bullmq": {
      "ioredis": "5.11.1"
    }
  }
}
