# ---------- Required ----------

# PostgreSQL. Managed providers usually need TLS: add ?sslmode=require (and e.g. &connection_limit=5 on small plans).
DATABASE_URL="postgresql://hirelab:hirelab@localhost:5432/hirelab"

# Redis. Use rediss:// (two s) for TLS-only providers.
REDIS_URL="redis://localhost:6379"

# Signs the login cookie. At least 32 random characters (the app refuses shorter ones in production).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Public URL of the site, no trailing slash. Used for apply links, e-mailed links and resume download URLs.
# In production this MUST be the real public https:// address (the worker only trusts resume URLs from this origin).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub token used by the worker to read candidates' PUBLIC profiles. A fine-grained token with no extra
# permissions is enough. The worker refuses to start without it.
GITHUB_TOKEN=""

# Encrypts each organization's stored AI provider key. Base64 of exactly 32 random bytes (same command as above).
# Changing it later makes already-stored keys unreadable.
ENCRYPTION_KEY=""

# Lets the worker download uploaded resumes from this app. Any long random string (same command as above).
# Required in practice: without it, every resume analysis fails with 401.
WORKER_INTERNAL_SECRET=""

# ---------- Required for AI scoring (LiteLLM proxy; see docker-compose.yml) ----------
LITELLM_PROXY_URL="http://localhost:4000"
# Must equal the proxy's own LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=""

# ---------- Optional ----------

# E-mail (Resend). Without these, invite / password-reset e-mails are not sent.
RESEND_API_KEY=""
EMAIL_FROM=""

# Leave EMPTY unless the apply form (public/apply.html) renders a Turnstile widget: when this is set, every
# application without a CAPTCHA token is rejected.
TURNSTILE_SECRET_KEY=""

# Virus scanning via ClamAV. Leave CLAMAV_HOST empty and UPLOAD_REQUIRE_VIRUS_SCAN "false" if you don't run ClamAV:
# with "true" and no ClamAV, ALL uploads are rejected.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
UPLOAD_REQUIRE_VIRUS_SCAN="false"

# ---------- Resume storage ----------
STORAGE_DRIVER="local"

# local driver: directory for uploads. Empty = ./uploads (the Docker image sets /data/uploads).
UPLOADS_DIR=""

# s3 driver (all four of the first group are required when STORAGE_DRIVER="s3"):
S3_ENDPOINT=""            # e.g. https://s3.eu-west-1.amazonaws.com or https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""              # AWS: the bucket's region. Cloudflare R2: auto. Empty = us-east-1.
S3_KEY_PREFIX=""          # optional folder inside the bucket, e.g. resumes/
S3_FORCE_PATH_STYLE="true"   # "false" = virtual-hosted style (bucket.endpoint); path style works everywhere
S3_ALLOW_HTTP="false"        # "true" only for a trusted private-network http:// endpoint (loopback is always allowed)
